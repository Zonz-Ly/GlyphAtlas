/* Help. */
"Help.01" = "تىزىملىك بالدىقىدىن «ئورۇندىن ئېچىش» نى تاللاپ، خەت نۇسخىسىنى شۇ قىسقۇچتىن بىۋاسىتە ئېچىڭ. خەت نۇسخىسى ھۆججىتىنى ئەپنىڭ سىنبەلگىسىگە ياكى خەت نۇسخىسى ئاللىقاچان ئېچىلغان كۆزنەككە سۆرەپمۇ ئاچالايسىز. Glyph Atlas نى خەت نۇسخىسى ھۆججەتلىرىنى ئاچىدىغان كۆڭۈلدىكى ئەپ قىلىپ تەڭشىسىڭىزمۇ بولىدۇ. يېقىندا ئېچىلغان ھۆججەتلەرنى قايتا ئاچقىلى بولىدۇ.";
"Help.02" = "تىزىملىك بالدىقىدىن بىر چېكىپ، نۆۋەتتىكى كۆزنەكتە ئېچىلغان خەت نۇسخىسىنى ئۆزىڭىزنىڭ خەت نۇسخىلىرى قىسقۇچىغا كۆچۈرەلەيسىز. بارلىق ئىشلەتكۈچىلەرنىڭ ئورتاق قىسقۇچىغا كۆچۈرۈش ئۈچۈن \U2066⌥\U2069 نى بېسىپ تۇرۇڭ.";
"Help.03" = "ئۆزگىرىشچان خەت نۇسخىسىنى ئاچسىڭىز، كۆزنەك كۇنۇپكىلىرىنىڭ يېنىدا تەڭشەش تاختىسى كۆرۈنىدۇ. ئۇنى ئوچۇق قالدۇرۇش ئۈچۈن سىرتقا سۆرەڭ. سان قىممىتىنى تاللاپ، \U2066↑/↓\U2069 ياكى \U2066⇧↑/⇧↓\U2069 بىلەن تەڭشەڭ.";
"Help.04" = "مۇناسىۋەتلىك ھەرپ شەكىللىرىنى كۆرۈش ئۈچۈن يان بالداققا بىر ياكى بىرنەچچە ھەرپ كىرگۈزۈڭ. يېڭى قۇرغا چۈشۈش ئۈچۈن \U2066⌥⏎\U2069 نى بېسىڭ. ئوڭ چېكىپ «ساقلانغان تېكىست» نى تاللىسىڭىز، ھازىرقى تېكىستنى ساقلىيالايسىز ياكى بۇرۇن ساقلانغان تېكىستنى تېز كىرگۈزەلەيسىز. ساقلانغان تېكىستنى تېز ئۆچۈرۈش ئۈچۈن تىزىملىك ئېچىلغاندا \U2066⌥\U2069 نى بېسىپ تۇرۇڭ.";
"Help.05" = "كۆڭۈلدىكى ھەرپ شەكلىنى ئالماشتۇرۇپ، باشقا شەكىللىرىنى كۆرۈش ئۈچۈن شەكىلنى قوش چېكىڭ ياكى ئۇنى تاللاپ \U2066⏎\U2069 نى بېسىڭ. شۇ چاغدا \U2066⇧\U2069 نى بېسىپ تۇرسىڭىز، شەكىل قوشۇلىدۇ.";
"Help.06" = "ھەرپ شەكىللىرى ئارىسىدا يۆتكىلىش ئۈچۈن \U2066↑/↓\U2069، ئاساسىي شەكىللەر ئارىسىدا يۆتكىلىش ئۈچۈن \U2066⌘↑/⌘↓\U2069، تىزىملىكتىكى بىرىنچى ياكى ئاخىرقى شەكىلگە ئۆتۈش ئۈچۈن \U2066⌥↑/⌥↓\U2069 نى ئىشلىتىڭ.";
"Help.07" = "تاللانغان ھەرپ شەكلىگە ماس كېلىدىغان بارلىق كودلانغان ھەرپلەرنى كۆچۈرۈش ئۈچۈن \U2066⌘C\U2069 نى بېسىڭ.";
"Help.08" = "كۆرسەتكۈچنى Unicode بەلگىسى ئۈستىدە تۇتسىڭىز، Unicode ئۆلچىمىدە بېكىتىلگەن ھەرپ نامى كۆرۈنىدۇ.";
"Help.09" = "كۆڭۈلدىكى كۆرۈنۈش «ھەرپ شەكىللىرى تورى». كۆرۈنۈشنى ئالماشتۇرۇش ئۈچۈن ئوڭ چېكىڭ ياكى «بىر ھەرپ شەكلى» ئۈچۈن \U2066⌘1\U2069، «ھەرپلەر» ئۈچۈن \U2066⌘2\U2069، «ھەرپ شەكىللىرى تورى» ئۈچۈن \U2066⌘3\U2069 نى بېسىڭ.";
"Help.10" = "«ھەرپلەر» كۆرۈنۈشىدە بىر شەكىلنى چەكسىڭىز، ئۇنىڭ ئالمىشىدىغان شەكىللىرىنى كۆرەلەيسىز. توغرا ۋە تىك يېزىشنى ئالماشتۇرۇش ئۈچۈن ئوڭ چېكىڭ ياكى \U2066⌘5\U2069 نى بېسىڭ. «تېكىستنى توغرىلاش» ۋە «خەت تىزىش» مۇ شۇ يەردە. «كۆرۈنۈش» تىزىملىكىدە تېخىمۇ كۆپ تاللانما بار.";
"Help.11" = "«ھەرپ شەكىللىرى تورى» كۆرۈنۈشىدە بىر شەكىلنى قوش چەكسىڭىز، ئۇ بار تېكىستكە قوشۇلىدۇ. يان بالداقتا بىر شەكىلنى چەكسىڭىز، ئۇ «ھەرپ شەكىللىرى تورى» كۆرۈنۈشىدە چاقنايدۇ. «خەت نۇسخىسى خاسلىقى بويىچە سۈزۈش» نى كۆرۈش ئۈچۈن ئوڭ چېكىڭ.";
"Help.12" = "تېكىستنى چوڭايتىش ياكى كىچىكلىتىش ئۈچۈن \U2066⌘+/⌘−\U2069 نى ئىشلىتىڭ ياكى سېزىمچان تاختىدا ئىككى بارماقنى يېقىنلاشتۇرۇڭ ياكى يىراقلاشتۇرۇڭ. «ھەرپلەر» كۆرۈنۈشىدە گىرۋەك بوشلۇقىنى ئۆزگەرتىش ئۈچۈن \U2066⌥⌘+/⌥⌘−\U2069 ياكى توغرىسىغا قىلىنغان شۇ ئىشارەتنى ئىشلىتىڭ. قۇر ئارىلىقىنى ئۆزگەرتىش ئۈچۈن \U2066⌃⌘+/⌃⌘−\U2069 ياكى تىك ئىشارەتنى ئىشلىتىڭ. كۆڭۈلدىكى چوڭلۇققا قايتىش ئۈچۈن \U2066⌘0\U2069 نى بېسىڭ.";
"Help.13" = "سايە چەگرا رامكىسىنى كۆرسىتىدۇ. ئۇنىڭدا ھەرپ شەكلىنىڭ كەڭلىكى، ئېگىزلىكى، شۇنداقلا قۇرنىڭ ئېگىزلىكى ۋە قۇر ئارىلىقى كۆرۈنىدۇ. سايىنى يوشۇرۇش ئۈچۈن \U2066⌘4\U2069 نى بېسىڭ.";
"Help.14" = "قاراڭغۇ ھالەتنى ئىشلەتكىلى بولىدۇ. ئىچى تولدۇرۇلغان ھەرپ شەكلىنى چەككەندە يورۇقلۇقى كۆزىڭىزنى قاماشتۇرۇشى مۇمكىن. تىزىملىك بالدىقىدىكى «رەڭلەر» دىن ھەرپ شەكلى، چەگرا رامكىسى سايىسى ۋە تەگلىك رەڭلىرىنى ئۆزگەرتەلەيسىز. رەڭلەرنى ساقلاش ئۈچۈن «ھازىرقى رەڭ تاختىسىنى ساقلاش» نى تاللاڭ. «رەڭ تاختىلىرىنى ئۆچۈرۈش» نى كۆرۈش ئۈچۈن \U2066⌥\U2069 نى بېسىپ تۇرۇڭ.";
"Help.15" = "ھازىرقى كۆرۈنۈش، رەڭلەر، چوڭلۇق، باشقا ئالدىن كۆرۈش تەڭشەكلىرى ۋە كۆزنەك چوڭلۇقىنى ساقلاش ئۈچۈن تىزىملىك بالدىقىدىن «كۆڭۈلدىكى تەڭشەك قىلىش» نى تاللاڭ. كېيىن ئېچىلغان خەت نۇسخىلىرى بۇ تەڭشەكلەرنى ئىشلىتىدۇ. «كۆڭۈلدىكى تەڭشەكنى ئەسلىگە كەلتۈرۈش» نى تاللاش ئۈچۈن \U2066⌥\U2069 نى بېسىپ تۇرۇڭ.";
