/* Help. */
"Help.01" = "Chọn “Mở…” trên thanh menu để mở phông chữ trực tiếp từ thư mục cài đặt phông chữ. Bạn cũng có thể kéo tệp vào biểu tượng ứng dụng hoặc vào cửa sổ đang mở một phông chữ, hay đặt Glyph Atlas làm ứng dụng mặc định để mở tệp phông chữ. Bạn có thể mở lại các tệp đã mở gần đây.";
"Help.02" = "Từ thanh menu, bạn có thể sao chép phông chữ đang mở trong cửa sổ hiện tại vào thư mục phông chữ của người dùng chỉ bằng một lần bấm. Giữ ⌥ để sao chép phông chữ vào thư mục phông chữ dành cho tất cả người dùng.";
"Help.03" = "Khi bạn mở phông chữ biến thiên, một bảng biến thiên xuất hiện cạnh các nút điều khiển cửa sổ. Kéo bảng ra để giữ bảng luôn mở. Chọn một giá trị số và dùng ↑/↓ hoặc ⇧↑/⇧↓ để điều chỉnh.";
"Help.04" = "Nhập một hoặc nhiều ký tự trong thanh bên để xem tất cả nét liên quan. Dùng ⌥⏎ để chèn dấu ngắt dòng. Bạn cũng có thể nhấp chuột phải rồi chọn “Văn bản đã lưu” để lưu văn bản hiện tại hoặc nhập nhanh văn bản đã lưu trước đó. Giữ ⌥ trên thanh menu để xóa nhanh văn bản đã lưu.";
"Help.05" = "Bấm hai lần vào một nét, hoặc chọn nét đó rồi nhấn ⏎, để thay thế nét mặc định và hiển thị các nét thay thế của nó. Giữ thêm ⇧ để thêm nét đó.";
"Help.06" = "Dùng ↑/↓ để di chuyển giữa các nét, ⌘↑/⌘↓ để di chuyển giữa các nét cơ sở và ⌥↑/⌥↓ để chuyển đến nét đầu tiên hoặc cuối cùng trong danh sách.";
"Help.07" = "Dùng ⌘C để sao chép tất cả ký tự được mã hóa của nét đã chọn.";
"Help.08" = "Di con trỏ lên nhãn mã Unicode để xem tên ký tự do tiêu chuẩn Unicode quy định.";
"Help.09" = "Lưới nét chữ là chế độ mặc định. Bấm chuột phải để chuyển chế độ xem, hoặc nhấn ⌘1 cho Một nét, ⌘2 cho Ký tự hay ⌘3 cho Lưới nét chữ.";
"Help.10" = "Trong Ký tự, bấm vào nét để xem các dạng thay thế. Có hỗ trợ viết dọc; bấm chuột phải hoặc nhấn ⌘5 để chuyển. Căn chỉnh Văn bản và Chữ viết cũng ở đây. Menu Xem trên thanh menu có thêm các tùy chọn.";
"Help.11" = "Trong chế độ Lưới nét chữ, bấm hai lần vào một nét để thêm vào văn bản hiện có. Bấm vào một nét trong thanh bên cũng làm nét đó nhấp nháy trong chế độ xem này. Bấm chuột phải để tìm mục “Lọc theo tính năng”.";
"Help.12" = "Dùng ⌘+/⌘− hoặc chụm và mở hai ngón tay trên bàn di chuột để tăng hoặc giảm cỡ chữ. Trong Ký tự, dùng ⌥⌘+/⌥⌘− hoặc chụm theo chiều ngang để tăng hoặc giảm lề; dùng ⌃⌘+/⌃⌘− hoặc chụm theo chiều dọc để tăng hoặc giảm giãn dòng. Nhấn ⌘0 để khôi phục kích thước mặc định.";
"Help.13" = "Bóng biểu thị khung bao, gồm chiều rộng và chiều cao của nét, chiều cao dòng và khoảng cách dòng của phần dàn chữ. Nhấn ⌘4 để ẩn.";
"Help.14" = "Có hỗ trợ chế độ tối, nhưng hãy cẩn thận: bấm vào một nét đặc có thể làm bạn chói mắt. Bạn có thể đổi màu nét, bóng của khung bao và nền trong Màu sắc trên thanh menu. Chọn “Lưu bảng màu hiện tại” để lưu các màu đã chỉnh. Giữ ⌥ để thấy mục “Xóa bảng màu”.";
"Help.15" = "Chọn Sử dụng làm mặc định trên thanh menu để lưu chế độ xem, màu sắc, kích thước và các thiết lập xem trước hiện tại cùng kích thước cửa sổ. Các tệp phông chữ mở sau đó sẽ dùng những thiết lập này. Giữ ⌥ để chọn Khôi phục giá trị mặc định.";
