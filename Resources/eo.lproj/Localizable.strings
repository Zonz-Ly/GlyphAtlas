"Help.01" = "Elektu «Malfermi el» en la menubreto por malfermi tiparon rekte el tipardosierujo. Vi ankaŭ povas treni tipardosieron sur la bildsimbolon de la programo aŭ en fenestron, en kiu jam estas malfermita tiparo. Vi povas elekti Glyph Atlas kiel la aprioran programon por malfermi tipardosierojn. Vi ankaŭ povas remalfermi lastatempe malfermitajn dosierojn.";
"Help.02" = "En la menubreto vi povas unuklake kopii la tiparon malfermitan en la nuna fenestro al via propra tipardosierujo. Tenu ⌥ por kopii ĝin al la tipardosierujo por ĉiuj uzantoj.";
"Help.03" = "Kiam vi malfermas varieblan tiparon, apud la fenestrobutonoj aperas panelo kun ĝiaj parametroj. Trenu la panelon eksteren por teni ĝin malfermita. Elektu nombran valoron kaj ĝustigu ĝin per ↑/↓ aŭ ⇧↑/⇧↓.";
"Help.04" = "Tajpu unu aŭ plurajn signojn en la flankobreto por vidi ĉiujn rilatajn glifojn. Premu ⌥⏎ por enmeti linifinon. Vi povas dekstre alklaki kaj elekti «Konservita teksto» por konservi la nunan tekston aŭ rapide enigi antaŭe konservitan tekston. Tenu ⌥ dum la menuo estas malfermita por rapide forigi konservitan tekston.";
"Help.05" = "Duoble alklaku glifon, aŭ elektu ĝin kaj premu ⏎, por anstataŭigi la aprioran glifon kaj vidi ĝiajn alternativojn. Tenu ⇧ dum la ago por aldoni la glifon.";
"Help.06" = "Uzu ↑/↓ por moviĝi inter glifoj, ⌘↑/⌘↓ por moviĝi inter bazaj glifoj kaj ⌥↑/⌥↓ por salti al la unua aŭ lasta glifo en la listo.";
"Help.07" = "Premu ⌘C por kopii ĉiujn koditajn signojn de la elektita glifo.";
"Help.08" = "Metu la musmontrilon sur Unikodan etikedon por vidi la nomon de la signo laŭ la Unikoda normo.";
"Help.09" = "La apriora vido estas «Glifa krado». Dekstre alklaku por ŝanĝi la vidon, aŭ premu ⌘1 por «Unuopa glifo», ⌘2 por «Signoj» aŭ ⌘3 por «Glifa krado».";
"Help.10" = "En «Signoj», alklaku glifon por vidi ĝiajn alternativojn. Dekstre alklaku aŭ premu ⌘5 por alterni inter horizontala kaj vertikala skribado. Ankaŭ disponeblas «Vicigo de teksto» kaj «Tipografio». Pliaj opcioj troviĝas en la menuo «Vido».";
"Help.11" = "En «Glifa krado», duoble alklaku glifon por aldoni ĝin al la ekzistanta teksto. Kiam vi alklakas glifon en la flankobreto, ĝi ekbriletas en «Glifa krado». Dekstre alklaku por trovi «Filtri laŭ tipara trajto».";
"Help.12" = "Uzu ⌘+/⌘− aŭ kunigu aŭ disigu du fingrojn sur la tuŝplato por pligrandigi aŭ malpligrandigi la tekston. En «Signoj», uzu ⌥⌘+/⌥⌘− aŭ la horizontalan geston por ŝanĝi la marĝenojn. Uzu ⌃⌘+/⌃⌘− aŭ la vertikalan geston por ŝanĝi la interlinian spacon. Premu ⌘0 por restarigi la aprioran grandon.";
"Help.13" = "La ombro montras la ĉirkaŭan kadron, kun la larĝo kaj alto de la glifo kaj la alto de la tekstlinioj kaj la interlinia spaco. Premu ⌘4 por kaŝi ĝin.";
"Help.14" = "La programo subtenas malhelan reĝimon. Tute plenigita glifo povas blindigi vin, se vi alklakas ĝin. En «Koloroj» en la menubreto vi povas ŝanĝi la kolorojn de la glifoj, la ombro de la ĉirkaŭa kadro kaj la fono. Elektu «Konservi nunan paletron» por konservi la kolorojn. Tenu ⌥ por vidi «Forigi paletrojn».";
"Help.15" = "Elektu «Uzi kiel apriorajn agordojn» en la menubreto por konservi la nunajn vidon, kolorojn, grandon, aliajn antaŭrigardajn agordojn kaj fenestrograndon. La tipardosieroj, kiujn vi malfermos poste, uzos tiujn agordojn. Tenu ⌥ por elekti «Restarigi apriorajn agordojn».";

