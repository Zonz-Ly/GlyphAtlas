/* Help. */
"Help.01" = "Чтобы открыть шрифт прямо из папки со шрифтами, выберите «Открыть из папки» в строке меню. Файл также можно перетащить на значок приложения или в окно, в котором уже открыт шрифт. Glyph Atlas можно сделать приложением по умолчанию для открытия файлов шрифтов. Недавно открытые файлы можно открыть снова.";
"Help.02" = "Через строку меню можно одним нажатием скопировать шрифт, открытый в текущем окне, в папку шрифтов пользователя. Удерживайте ⌥, чтобы скопировать шрифт в папку шрифтов для всех пользователей.";
"Help.03" = "При открытии вариативного шрифта рядом с кнопками управления окном появляется панель вариаций. Перетащите её за пределы окна, чтобы оставить открытой. Выберите числовое значение и измените его клавишами ↑/↓ или ⇧↑/⇧↓.";
"Help.04" = "Введите один или несколько символов в боковой панели, чтобы увидеть все связанные глифы. Для переноса строки нажмите ⌥⏎. Также можно нажать правую кнопку мыши и выбрать «Сохранённые тексты», чтобы сохранить текущий текст или быстро вставить сохранённый ранее. Удерживайте ⌥ в строке меню, чтобы быстро удалять сохранённые тексты.";
"Help.05" = "Дважды нажмите глиф или выберите его и нажмите Return, чтобы заменить глиф по умолчанию и показать его альтернативы. Удерживайте при этом Shift, чтобы добавить этот глиф.";
"Help.06" = "Используйте ↑/↓ для перехода между глифами, ⌘↑/⌘↓ — между базовыми глифами, а ⌥↑/⌥↓ — для перехода к первому или последнему глифу списка.";
"Help.07" = "Нажмите ⌘C, чтобы скопировать все закодированные символы выбранного глифа.";
"Help.08" = "Наведите указатель на метку Unicode, чтобы увидеть название символа, определенное стандартом Unicode.";
"Help.09" = "По умолчанию открывается режим «Сетка глифов». Переключайте режим правой кнопкой мыши или клавишами: ⌘1 — «Один глиф», ⌘2 — «Символы», ⌘3 — «Сетка глифов».";
"Help.10" = "В режиме «Символы» нажмите на глиф, чтобы увидеть его варианты. Поддерживается вертикальное письмо: переключайте его правой кнопкой мыши или сочетанием ⌘5. Здесь же находятся выравнивание текста и «Типографика». Другие настройки доступны в меню «Вид».";
"Help.11" = "В режиме «Сетка глифов» дважды нажмите глиф, чтобы добавить его к имеющемуся тексту. При нажатии глифа в боковой панели он также мигает в общем списке. Нажмите правой кнопкой мыши, чтобы найти пункт «Фильтр по функции».";
"Help.12" = "Используйте ⌘+/⌘− или жест сведения и разведения пальцев на трекпаде для увеличения или уменьшения текста. В режиме «Символы» сочетания ⌥⌘+/⌥⌘− или горизонтальный жест меняют поля, а ⌃⌘+/⌃⌘− или вертикальный жест — межстрочный интервал. Нажмите ⌘0, чтобы вернуть размер по умолчанию.";
"Help.13" = "Тень показывает ограничивающую рамку, включая ширину и высоту глифа, высоту строки и межстрочный интервал. Нажмите ⌘4, чтобы скрыть её.";
"Help.14" = "Поддерживается темный режим. Но будьте осторожны: при нажатии на сплошной глиф можно ослепнуть от яркости. В пункте «Цвета» строки меню можно изменить цвет глифов, тени ограничивающей рамки и фона. Чтобы сохранить выбранные цвета, выберите «Сохранить текущую палитру». Удерживайте ⌥, чтобы увидеть пункт «Удалить палитры».";
"Help.15" = "Выберите «Сделать параметрами по умолчанию» в строке меню, чтобы сохранить текущий вид, цвета, размер и другие настройки предпросмотра вместе с размером окна. Открываемые затем файлы шрифтов будут использовать эти настройки. Удерживайте ⌥, чтобы выбрать «Восстановить настройки по умолчанию».";
