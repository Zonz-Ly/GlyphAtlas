"Help.01" = "Open a font, or drag one onto the app's window or Dock icon. Recently used fonts are supported.";
"Help.02" = "Type one or more characters in the sidebar to see all associated glyphs. Use ⌥⏎ to insert a line break.";
"Help.03" = "Double-click a glyph, or select it and press Return, to replace the default glyph and show that glyph's substitution. Press and hold Shift together to add that glyph.";
"Help.04" = "Use ↑/↓ to move between glyphs, ⌘↑/⌘↓ to move between base glyphs, and ⌥↑/⌥↓ to jump to the first or last glyph in the list.";
"Help.05" = "Use ⌘C to copy all encoded characters of the selected glyph.";
"Help.06" = "Hover over a Unicode badge to see the character name defined by the Unicode standard.";
"Help.07" = "All Glyphs is the default. Right-click to switch views, or press ⌘1 for Single Glyph, ⌘2 for Multi-Character, or ⌘3 for All Glyphs.";
"Help.08" = "In Multi-Character, click a glyph to view its alternates. Vertical writing is supported; right-click or press ⌘5 to switch writing direction.";
"Help.09" = "In All Glyphs, double-click a glyph to add it to the existing text. Clicking a glyph in the sidebar also makes it blink there.";
"Help.10" = "Use ⌘+/⌘- to zoom the glyphs, and ⌥⌘+/⌥⌘- to resize the margins in Multi-Character. Trackpad pinch also works.";
"Help.11" = "The page shadow shows the glyph's width and height, as well as the layout's line height and leading; press ⌘4 to hide it.";
"Help.12" = "Dark mode is supported. but be careful: clicking a solid glyph can blind you.";

