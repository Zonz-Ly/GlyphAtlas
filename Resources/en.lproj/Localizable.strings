/* Help. */
"Help.01" = "Use “Open…” in the menu bar to open a font directly from a Fonts folder. You can also drag a font onto the app icon or onto a window with a font already open, or set Glyph Atlas as the default app for opening font files. Recently opened items are supported.";
"Help.02" = "Use the menu bar to copy the font open in the current window to your user Fonts folder in one click. Hold ⌥ to copy it to the Fonts folder for all users.";
"Help.03" = "When you open a variable font, a variation panel appears beside the window controls. Drag it out to keep it open. Select a numeric value and use ↑/↓ or ⇧↑/⇧↓ to adjust it.";
"Help.04" = "Type one or more characters in the sidebar to see all associated glyphs. Use ⌥⏎ to insert a line break. You can also right-click and choose “Saved Text” to save the current text or quickly enter text you’ve saved before. Hold ⌥ in the menu bar to quickly delete saved text.";
"Help.05" = "Double-click a glyph, or select it and press ⏎, to replace the default glyph and show its alternates. Hold ⇧ while doing this to add the glyph.";
"Help.06" = "Use ↑/↓ to move between glyphs, ⌘↑/⌘↓ to move between base glyphs, and ⌥↑/⌥↓ to jump to the first or last glyph in the list.";
"Help.07" = "Use ⌘C to copy all encoded characters of the selected glyph.";
"Help.08" = "Hover over a Unicode badge to see the character name defined by the Unicode standard.";
"Help.09" = "Glyph Grid is the default. Right-click to switch views, or press ⌘1 for Single Glyph, ⌘2 for Characters, or ⌘3 for Glyph Grid.";
"Help.10" = "In the Characters view, click a glyph to view its alternates. Choose Vertical Layout from the shortcut menu or press ⌘5 to switch between horizontal and vertical writing. Text alignment and Typography are here too. The View menu in the menu bar has more options.";
"Help.11" = "In Glyph Grid, double-click a glyph to add it to the existing text. Clicking a glyph in the sidebar makes it blink in Glyph Grid. Right-click to find Filter by Feature.";
"Help.12" = "Use ⌘+/⌘− to make text bigger or smaller, or pinch on the trackpad. In the Characters view, use ⌥⌘+/⌥⌘− or a horizontal pinch to increase or decrease the margins, and ⌃⌘+/⌃⌘− or a vertical pinch to increase or decrease leading. Press ⌘0 to restore the default size.";
"Help.13" = "The shadow shows the bounding box, including the glyph's width and height and the layout's line height and leading. Press ⌘4 to toggle Bounding Box.";
"Help.14" = "Dark mode is supported. Watch out when clicking a solid glyph, as it can dazzle you. You can change the glyph, bounding box shadow, and background colors under Colors in the menu bar. Choose Save Current Palette to keep your colors. Hold ⌥ to find Delete Palettes.";
"Help.15" = "Choose Use as Defaults in the menu bar to save the current view, colors, size, other preview settings, and window size. Font files you open later will use these settings. Hold ⌥ to choose Restore Default instead.";
