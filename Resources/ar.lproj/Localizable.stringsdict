<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>“%@” contains %lu styles.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>يحتوي «⁨%1$@⁩» على %2$#@styles@.</string>
		<key>styles</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>zero</key>
			<string>صفر من الأنماط</string>
			<key>one</key>
			<string>نمط واحد</string>
			<key>two</key>
			<string>نمطين</string>
			<key>few</key>
			<string>%lu أنماط</string>
			<key>many</key>
			<string>%lu نمطًا</string>
			<key>other</key>
			<string>%lu نمط</string>
		</dict>
	</dict>
</dict>
</plist>
