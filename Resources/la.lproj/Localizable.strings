/* Help. */
"Help.01" = "In serie indicum elige «Aperire…» ut typum e directorio typorum directe aperias. Potes etiam fasciculum ad iconem programmatis vel in fenestram trahere in qua typus iam apertus est. Glyph Atlas designare potes ut programma praefinitum ad fasciculos typorum aperiendos. Fasciculi nuper aperti iterum aperiri possunt.";
"Help.02" = "Ex serie indicum uno ictu typum in fenestra praesenti apertum in directorium typorum tuum copia. Clavem ⌥ tene ut typum in directorium omnibus utentibus commune copies.";
"Help.03" = "Cum typum variabilem aperis, tabula parametrorum iuxta globulos fenestrae apparet. Tabulam extra trahe ut aperta maneat. Valorem numericum elige eumque clavibus ↑/↓ vel ⇧↑/⇧↓ compone.";
"Help.04" = "Unum vel plura signa in tabula laterali insere ut omnes formas pertinentes videas. Clavibus ⌥⏎ lineam novam incipe. Dextro muris globulo preme et «Textus servatus» elige ut textum praesentem serves aut textum antea servatum celeriter inseras. Dum index apertus est, ⌥ tene ut textum servatum celeriter deleas.";
"Help.05" = "Formam bis preme vel eam elige ac ⏎ preme ut formam praefinitam substituas et formas alternativas videas. Dum hoc agis, ⇧ tene ut formam addas.";
"Help.06" = "Clavibus ↑/↓ inter formas, ⌘↑/⌘↓ inter formas principales moveare. Clavibus ⌥↑/⌥↓ ad primam vel ultimam indicis formam sali.";
"Help.07" = "Claves ⌘C preme ut omnia signa codice definita formae selectae copies.";
"Help.08" = "Indicem muris super notam Unicode siste ut nomen signi a norma Unicode definitum videas.";
"Help.09" = "Initio «Craticula formarum» ostenduntur. Dextro muris globulo prospectum muta aut ⌘1 pro «Forma singula», ⌘2 pro «Signa» vel ⌘3 pro «Craticula formarum» preme.";
"Help.10" = "In prospectu «Signa» formam preme ut formas alternativas videas. Dextro muris globulo aut ⌘5 preme ut inter scripturam horizontalem et verticalem alternes. Ibi etiam «Aptatio textus» et «Typographia» adsunt. In indice «Prospectus» plura eligere potes.";
"Help.11" = "In prospectu «Craticula formarum» formam bis preme ut eam textui iam inscripto addas. Formam in tabula laterali preme ut in prospectu «Craticula formarum» micet. Dextro muris globulo preme ut «Secundum proprietatem seligere» invenias.";
"Help.12" = "Clavibus ⌘+/⌘− vel duobus digitis in tabula tactili contractis aut diductis textum amplifica vel minue. In «Signa» clavibus ⌥⌘+/⌥⌘− vel gestu horizontali margines muta. Clavibus ⌃⌘+/⌃⌘− vel gestu verticali intervallum linearum muta. Claves ⌘0 preme ut ad magnitudinem praefinitam redeas.";
"Help.13" = "Umbra rectangulum circumiacens indicat, quod latitudinem altitudinemque formae ac linearum altitudinem et intervallum complectitur. Claves ⌘4 preme ut illud celes.";
"Help.14" = "Modus obscurus adhiberi potest. Cave ne forma pigmento impleta te perstringat cum eam premis. In «Colores» colorem formae, umbrae rectanguli circumiacentis et fundi mutare potes. Elige «Tabulam colorum praesentem servare» ut colores serves. Clavem ⌥ tene ut «Tabulas colorum delere» appareat.";
"Help.15" = "In serie indicum elige «Pro praefinitis adhibere» ut prospectum praesentem, colores, magnitudinem, alias optiones praevisionis et magnitudinem fenestrae serves. Fasciculi typorum postea aperti his optionibus utentur. Clavem ⌥ tene ut «Praefinita restituere» eligas.";
