"Help.01" = "फ़ॉन्ट फ़ोल्डर से सीधे फ़ॉन्ट खोलने के लिए मेनू बार में “फ़ॉन्ट खोलने की जगह” चुनें। आप फ़ॉन्ट को ऐप के आइकॉन या ऐसी विंडो पर भी ड्रैग कर सकते हैं जिसमें कोई फ़ॉन्ट पहले से खुला है। आप Glyph Atlas को फ़ॉन्ट फ़ाइलें खोलने के लिए डिफ़ॉल्ट ऐप बना सकते हैं। हाल में खोले गए आइटम भी दोबारा खोले जा सकते हैं।";
"Help.02" = "मेनू बार से मौजूदा विंडो में खुले फ़ॉन्ट को एक क्लिक में अपने फ़ॉन्ट फ़ोल्डर में कॉपी करें। सभी यूज़र के फ़ॉन्ट फ़ोल्डर में कॉपी करने के लिए ⌥ दबाए रखें।";
"Help.03" = "वैरिएबल फ़ॉन्ट खोलने पर विंडो के कंट्रोल के पास वैरिएशन पैनल दिखाई देता है। उसे खुला रखने के लिए बाहर ड्रैग करें। कोई संख्यात्मक मान चुनें और उसे ↑/↓ या ⇧↑/⇧↓ से बदलें।";
"Help.04" = "सभी संबंधित ग्लिफ़ देखने के लिए साइडबार में एक या अधिक वर्ण टाइप करें। नई लाइन डालने के लिए ⌥⏎ दबाएँ। मौजूदा टेक्स्ट सहेजने या पहले सहेजा गया टेक्स्ट तुरंत दर्ज करने के लिए सेकेंडरी क्लिक करें और “सहेजा गया टेक्स्ट” चुनें। सहेजा गया टेक्स्ट तुरंत डिलीट करने के लिए मेनू बार में ⌥ दबाए रखें।";
"Help.05" = "डिफ़ॉल्ट ग्लिफ़ बदलने और उसके वैकल्पिक रूप देखने के लिए किसी ग्लिफ़ पर डबल क्लिक करें, या उसे चुनकर ⏎ दबाएँ। ग्लिफ़ जोड़ने के लिए इस दौरान ⇧ दबाए रखें।";
"Help.06" = "ग्लिफ़ के बीच जाने के लिए ↑/↓, मूल ग्लिफ़ के बीच जाने के लिए ⌘↑/⌘↓ और सूची के पहले या आखिरी ग्लिफ़ पर जाने के लिए ⌥↑/⌥↓ दबाएँ।";
"Help.07" = "चुने गए ग्लिफ़ के सभी एनकोड किए गए वर्ण कॉपी करने के लिए ⌘C दबाएँ।";
"Help.08" = "Unicode बैज पर पॉइंटर रखें। वहाँ Unicode मानक में दिया गया वर्ण का नाम दिखाई देगा।";
"Help.09" = "डिफ़ॉल्ट दृश्य “सभी ग्लिफ़” है। दृश्य बदलने के लिए सेकेंडरी क्लिक करें या “एक ग्लिफ़” के लिए ⌘1, “एक से अधिक वर्ण” के लिए ⌘2 या “सभी ग्लिफ़” के लिए ⌘3 दबाएँ।";
"Help.10" = "“एक से अधिक वर्ण” दृश्य में किसी ग्लिफ़ के वैकल्पिक रूप देखने के लिए उस पर क्लिक करें। क्षैतिज और लंबवत लेखन के बीच स्विच करने के लिए सेकेंडरी क्लिक करें या ⌘5 दबाएँ। “टेक्स्ट अलाइनमेंट” और “टाइपोग्राफ़ी” भी यहाँ हैं। मेनू बार के “दृश्य” मेनू में और विकल्प हैं।";
"Help.11" = "“सभी ग्लिफ़” दृश्य में किसी ग्लिफ़ को मौजूदा टेक्स्ट में जोड़ने के लिए उस पर डबल क्लिक करें। साइडबार में किसी ग्लिफ़ पर क्लिक करने से वह “सभी ग्लिफ़” दृश्य में झपकता है। “फ़ीचर के अनुसार फ़िल्टर करें” देखने के लिए सेकेंडरी क्लिक करें।";
"Help.12" = "ग्लिफ़ को बड़ा या छोटा करने के लिए ⌘+/⌘− दबाएँ या ट्रैकपैड पर उँगलियाँ फैलाएँ या समेटें। “एक से अधिक वर्ण” दृश्य में मार्जिन बढ़ाने या घटाने के लिए ⌥⌘+/⌥⌘− या क्षैतिज पिंच जेस्चर का उपयोग करें, और लाइन स्पेसिंग बढ़ाने या घटाने के लिए ⌃⌘+/⌃⌘− या लंबवत पिंच जेस्चर का उपयोग करें। डिफ़ॉल्ट आकार वापस पाने के लिए ⌘0 दबाएँ।";
"Help.13" = "छाया बाउंडिंग बॉक्स दिखाती है। इसमें ग्लिफ़ की चौड़ाई और ऊँचाई के साथ टेक्स्ट लेआउट की लाइन की ऊँचाई और लाइन स्पेसिंग शामिल हैं। इसे छिपाने के लिए ⌘4 दबाएँ।";
"Help.14" = "डार्क मोड उपलब्ध है। किसी भरे हुए ग्लिफ़ पर क्लिक करते समय ध्यान रखें कि उसकी चमक से आँखें चौंधिया सकती हैं। मेनू बार में “रंग” से ग्लिफ़, बाउंडिंग बॉक्स की छाया और बैकग्राउंड के रंग बदलें। रंग सहेजने के लिए “मौजूदा पैलेट सहेजें” चुनें। “पैलेट डिलीट करें” देखने के लिए ⌥ दबाए रखें।";
"Help.15" = "मौजूदा दृश्य, रंग, आकार, अन्य प्रीव्यू सेटिंग्ज़ और विंडो का आकार सहेजने के लिए मेनू बार में “डिफ़ॉल्ट के रूप में उपयोग करें” चुनें। बाद में खोली गई फ़ॉन्ट फ़ाइलें इन सेटिंग्ज़ का उपयोग करेंगी। “डिफ़ॉल्ट पर रीस्टोर करें” चुनने के लिए ⌥ दबाए रखें।";

